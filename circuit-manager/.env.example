# Circuit Manager Environment Variables
# Copy this file to .env and update the values

# PostgreSQL
POSTGRES_USER=circuit_user
POSTGRES_PASSWORD=circuit_pass
POSTGRES_DB=circuit_db

# Hasura
HASURA_GRAPHQL_ADMIN_SECRET=circuit_admin_secret
# Must be 32+ characters
HASURA_GRAPHQL_JWT_SECRET_KEY=circuit_jwt_secret_key_minimum_32_chars_long!

# Next.js
JWT_SECRET=circuit_jwt_secret_key_minimum_32_chars_long!
NEXTAUTH_SECRET=nextauth_secret_key_32_chars_minimum!
NEXTAUTH_URL=http://localhost:3000

# For production, change all values above to strong random secrets:
# openssl rand -base64 32
